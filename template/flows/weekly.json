              "operationMetadataId": "76d279f7-e3df-4a83-91ef-c07fd66538b9"
            },
            "type": "OpenApiConnection",
            "inputs": {
              "parameters": {
                "dataset": "__MS_LISTS_SITE__",
                "table": "__MS_LIST_SUBMISSIONS__",
                "itemId": "@items('Pull_out_attachments_and_prepare')?['ID']"
              },
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "connectionName": "shared_sharepointonline_7",
                "operationId": "GetItemAttachments"
              },
              "authentication": {
                "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
                "type": "Raw"
              }
            }
          },
          "Apply_to_each_2": {
            "foreach": "@body('Get_attachments')",
            "actions": {
              "Get_attachment_content": {
                "metadata": {
                  "operationMetadataId": "fcf1c747-dd05-449a-bb51-087d414c8310"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "__MS_LISTS_SITE__",
                    "table": "__MS_LIST_SUBMISSIONS__",
                    "itemId": "@items('Pull_out_attachments_and_prepare')?['ID']",
                    "attachmentId": "@item()?['Id']"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline_9",
                    "operationId": "GetAttachmentContent"
                  },
                  "authentication": {
                    "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
                    "type": "Raw"
                  }
                }
              },
              "Create_file": {
                "runAfter": {
                  "Increment_variable": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "cb0f7e0b-a9d2-4f39-9a97-f13410f37417"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "__MS_OUTPUT_SITE__",
                    "folderPath": "/__MS_LIBRARY_NAME__/@{variables('FolderName')}/@{items('Pull_out_attachments_and_prepare')?['Type_x0020_of_x0020_thing/Value']}",
                    "name": "@{items('Pull_out_attachments_and_prepare')?['Type_x0020_of_x0020_thing']?['Value']} @{formatNumber(variables('ItemNo'), '000')} - @{items('Pull_out_attachments_and_prepare')?['Title']} - @{replace(coalesce(items('Pull_out_attachments_and_prepare')?['Cost_x0020_Account']?['Value'], ''), ':', '-')}@{if(empty(string(items('Pull_out_attachments_and_prepare')?['Amount'])), '', concat(' - ', formatNumber(float(items('Pull_out_attachments_and_prepare')?['Amount']), 'C2', 'en-US')))}_@{variables('Step')}.@{last(split(item()?['DisplayName'], '.'))}",
                    "body": "@body('Get_attachment_content')"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline_10",
                    "operationId": "CreateFile"
                  },
                  "authentication": {
                    "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
                    "type": "Raw"
                  }
                },
                "runtimeConfiguration": {
                  "contentTransfer": {
                    "transferMode": "Chunked"
                  }
                }
              },
              "Increment_variable": {
                "runAfter": {
                  "Get_attachment_content": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "e9a439e1-be56-439c-82ed-ee23a9474633"
                },
                "type": "IncrementVariable",
                "inputs": {
                  "name": "Step"
                }
              },
              "Add_file_link": {
                "runAfter": {
                  "Create_file": [
                    "Succeeded"
                  ]
                },
                "type": "AppendToArrayVariable",
                "inputs": {
                  "name": "FileLinks",
                  "value": "@concat('__MS_OUTPUT_SITE__/_layouts/15/embed.aspx?UniqueId=', toLower(substring(outputs('Create_file')?['body/ETag'], 2, 36)))"
                }
              }
            },
            "runAfter": {
              "Get_attachments": [
                "Succeeded"
              ]
            },
            "metadata": {
              "operationMetadataId": "27639c8f-52d4-4113-b09c-753617640a4a"
            },
            "type": "Foreach",
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 1
              }
            }
          },
          "Compose_Excel_Row": {
            "runAfter": {
              "Mark_processed_unless_testing": [
