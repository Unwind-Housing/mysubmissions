      "Send_an_email_(V2)": {
        "runAfter": {
          "Delay": [
            "Succeeded"
          ],
          "Reminder_lines": [
            "Succeeded"
          ]
        },
        "type": "OpenApiConnection",
        "inputs": {
          "parameters": {
            "emailMessage/To": "__MS_FINANCE_DIRECTOR__@{if(variables('TestMode'), '', concat(';', variables('Recipients')))}",
            "emailMessage/Subject": "@{if(variables('TestMode'), '[TEST v4] ', '')}__MS_SUBJECT__ - @{variables('FolderName')}@{if(equals(actions('Check_for_existing_workbook')?['status'], 'Succeeded'), ' (updated)', '')}",
            "emailMessage/Body": "<p class=\"editor-paragraph\">__MS_GREETING__</p><br><p class=\"editor-paragraph\">Weekly Financial Processing is ready for __MS_ORG_NAME__.</p><p class=\"editor-paragraph\">@{if(equals(actions('Check_for_existing_workbook')?['status'], 'Succeeded'), concat(string(length(body('Get_all_items_that_are_ready_for_processing')?['value'])), if(equals(length(body('Get_all_items_that_are_ready_for_processing')?['value']), 1), ' more item', ' more items'), ' added (ItemNo ', string(add(length(body('Rows_already_filled_in')), 1)), ' to ', string(variables('ItemNo')), '). Same folder and workbook as earlier today.'), concat(string(length(body('Get_all_items_that_are_ready_for_processing')?['value'])), if(equals(length(body('Get_all_items_that_are_ready_for_processing')?['value']), 1), ' item', ' items'), ' this week (ItemNo 1 to ', string(variables('ItemNo')), ').'))}</p><br><p class=\"editor-paragraph\">Here is the folder with images of each financial thing:</p><p class=\"editor-paragraph\">@{outputs('Create_root_folder')?['body/{Link}']}</p><br><p class=\"editor-paragraph\">And here is an excel file with this week's combined details:</p><p class=\"editor-paragraph\">@{outputs('Get_file_properties')?['body/{Link}']}<br></p><br>@{if(empty(body('Reminders_due_soon')), '', concat('<p class=\"editor-paragraph\"><b>Payment reminders</b></p><ul>', join(body('Reminder_lines'), ''), '</ul><br>'))}<p class=\"editor-paragraph\">Thank you!</p><br>",
            "emailMessage/ReplyTo": "__MS_REPLY_TO__",
            "emailMessage/Importance": "Normal"
          },
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
            "connectionName": "shared_office365",
            "operationId": "SendEmailV2"
          },
          "authentication": {
            "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
            "type": "Raw"
          }
        }
      },
