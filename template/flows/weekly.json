            "type": "Compose",
            "inputs": {
              "ItemNo": "@{variables('ItemNo')}",
              "Type": "@{items('Pull_out_attachments_and_prepare')?['Type_x0020_of_x0020_thing']?['Value']}",
              "Vendor": "@{items('Pull_out_attachments_and_prepare')?['Title']}",
              "Project": "@{items('Pull_out_attachments_and_prepare')?['Project/Value']}",
              "CostAccount": "@{items('Pull_out_attachments_and_prepare')?['Cost_x0020_Account']?['Value']}",
              "Comment": "@{items('Pull_out_attachments_and_prepare')?['Comments']}",
              "Amount": "@{items('Pull_out_attachments_and_prepare')?['Amount']}",
              "ProcessedDate": "@{triggerBody()?['text']}",
              "LinkToThing": "@{items('Pull_out_attachments_and_prepare')?['{Link}']}",
              "FileCount": "@{length(body('Get_attachments'))}",
              "File1URL": "@{if(greater(length(variables('FileLinks')), 0), variables('FileLinks')[0], '')}",
              "File2URL": "@{if(greater(length(variables('FileLinks')), 1), variables('FileLinks')[1], '')}",
              "File3URL": "@{if(greater(length(variables('FileLinks')), 3), if(equals(items('Pull_out_attachments_and_prepare')?['Type_x0020_of_x0020_thing']?['Value'], 'Invoice'), outputs('Create_Invoice_folder')?['body/{Link}'], if(equals(items('Pull_out_attachments_and_prepare')?['Type_x0020_of_x0020_thing']?['Value'], 'Receipt'), outputs('Create_Receipt_folder')?['body/{Link}'], if(equals(items('Pull_out_attachments_and_prepare')?['Type_x0020_of_x0020_thing']?['Value'], 'Reimbursement'), outputs('Create_Reimbursement_folder')?['body/{Link}'], if(equals(items('Pull_out_attachments_and_prepare')?['Type_x0020_of_x0020_thing']?['Value'], 'Deposit'), outputs('Create_Deposit_Folder')?['body/{Link}'], outputs('Create_root_folder')?['body/{Link}'])))), if(greater(length(variables('FileLinks')), 2), variables('FileLinks')[2], ''))}",
              "FolderURL": "@{outputs('Create_root_folder')?['body/{Link}']}"
            }
          },
          "Add_a_row_into_a_table": {
            "runAfter": {
              "Compose_Excel_Row": [
                "Succeeded"
              ]
            },
            "type": "OpenApiConnection",
            "inputs": {
              "parameters": {
                "source": "__MS_EXCEL_SOURCE__",
                "drive": "__MS_EXCEL_DRIVE__",
                "file": "@{variables('FolderName')}/FinancialThings-@{variables('FolderName')}.xlsx",
                "table": "WeeklySubmissions",
                "item": "@outputs('Compose_Excel_Row')"
              },
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
                "connectionName": "shared_excelonlinebusiness",
                "operationId": "AddRowV2"
              },
              "authentication": {
                "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
                "type": "Raw"
              }
            }
          },
          "Clear_FileLinks": {
            "runAfter": {},
            "type": "SetVariable",
            "inputs": {
              "name": "FileLinks",
              "value": []
            }
          },
          "Next_item_number": {
            "runAfter": {
              "Clear_FileLinks": [
                "Succeeded"
              ]
            },
            "type": "IncrementVariable",
            "inputs": {
              "name": "ItemNo",
              "value": 1
            }
          },
          "Restart_file_count": {
            "runAfter": {
              "Next_item_number": [
                "Succeeded"
              ]
            },
            "type": "SetVariable",
            "inputs": {
              "name": "Step",
              "value": 0
            }
          },
          "Mark_processed_unless_testing": {
            "actions": {
              "Update_item": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "62871f51-2ab9-491c-adfa-330b45158dcd"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "__MS_LISTS_SITE__",
                    "table": "__MS_LIST_SUBMISSIONS__",
                    "id": "@items('Pull_out_attachments_and_prepare')?['ID']",
                    "item/Title": "@items('Pull_out_attachments_and_prepare')?['Title']",
                    "item/Processed": true,
                    "item/ProcessedDate": "@utcNow()",
                    "item/Amount": "@items('Pull_out_attachments_and_prepare')?['Amount']"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline_8",
                    "operationId": "PatchItem"
                  },
                  "authentication": {
                    "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
                    "type": "Raw"
                  }
                }
              }
            },
            "runAfter": {
              "Apply_to_each_2": [
                "Succeeded"
              ]
            },
            "else": {
              "actions": {}
            },
            "expression": {
              "and": [
                {
                  "equals": [
                    "@variables('TestMode')",
                    false
                  ]
                }
              ]
            },
            "type": "If"
          }
        },
        "runAfter": {
          "Initialize_ItemNo": [
            "Succeeded"
          ]
        },
        "metadata": {
          "operationMetadataId": "cb4fd6ce-ac56-442b-ae5e-1969345822dc"
        },
        "type": "Foreach",
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        }
      },
      "Create_root_folder": {
        "runAfter": {
          "Initialize_folder_name_(date)": [
            "Succeeded"
          ]
        },
        "metadata": {
          "operationMetadataId": "afa7b565-850f-4040-977b-a95665953dea"
